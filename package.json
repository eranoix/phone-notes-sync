{
  "name": "phone-notes-sync",
  "version": "1.0.0",
  "description": "Real-time sync of Apple Notes stored in an IMAP mailbox into Postgres, using IMAP IDLE, UID bookkeeping and an idempotent upsert.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "dev": "tsx src/main.ts",
    "seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "demo": "docker compose up --build",
    "demo:down": "docker compose down -v",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "imapflow": "^2.0.7",
    "mailparser": "^3.9.28",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "license": "MIT"
}
